{
  "name": "lyvo-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter demo build",
    "astro": "pnpm --filter demo astro",
    "deploy": "pnpm --filter demo exec wrangler deploy",
    "format": "prettier --write .",
    "lint": "oxlint --fix",
    "bump": "pnpm self-update && pnpm up -r --latest",
    "bump:pick": "pnpm up -r --latest -i",
    "test": "vitest run --root packages/lyvo"
  },
  "devDependencies": {
    "oxlint": "^1.86.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
