{
  "name": "lyvo-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter demo build",
    "astro": "pnpm --filter demo astro",
    "deploy": "pnpm --filter demo exec wrangler deploy",
    "format": "prettier --write .",
    "lint": "oxlint --fix",
    "update-deps": "pnpm up -r -i -L",
    "update:all": "pnpm up --latest -r",
    "test": "vitest run --root packages/lyvo"
  },
  "devDependencies": {
    "oxlint": "^1.86.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11"
}
