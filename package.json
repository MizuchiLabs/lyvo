{
  "name": "lyvo-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter demo build",
    "astro": "pnpm --filter demo astro",
    "deploy": "pnpm --filter demo exec wrangler deploy",
    "format": "prettier --write .",
    "lint": "oxlint --fix",
    "bump": "pnpm self-update && pnpm up -r --latest",
    "bump:pick": "pnpm up -r --latest -i",
    "test": "vitest run --root packages/lyvo"
  },
  "devDependencies": {
    "oxlint": "^1.87.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
