{
	"name": "@mizuchilabs/lyvo",
	"version": "0.2.0",
	"description": "Docs, API reference and landing pages for your app, as one Astro integration.",
	"keywords": [
		"astro",
		"astro-template",
		"astro-theme",
		"docs",
		"documentation"
	],
	"license": "Apache-2.0",
	"homepage": "https://lyvo.mizuchi.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MizuchiLabs/lyvo.git",
		"directory": "packages/lyvo"
	},
	"type": "module",
	"exports": {
		".": "./src/integration.ts",
		"./components/base/*": "./src/components/base/*",
		"./components/docs/*": "./src/components/docs/*",
		"./components/openapi/*": "./src/components/openapi/*",
		"./components/landing/*": "./src/components/landing/*",
		"./layouts/*": "./src/layouts/*",
		"./collections": "./src/lib/collections.ts",
		"./schema": "./src/schema.ts",
		"./style.css": "./src/styles/global.css",
		"./routes/*": "./src/routes/*",
		"./types": "./types.d.ts"
	},
	"files": [
		"src",
		"types.d.ts"
	],
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "oxlint --fix",
		"format": "prettier --write .",
		"test": "vitest run"
	},
	"dependencies": {
		"@apidevtools/swagger-parser": "^13.1.0",
		"@astrojs/markdown-remark": "^7.3.2",
		"@astrojs/mdx": "^8.0.3",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource/inter": "^5.3.0",
		"@lucide/astro": "^1.54.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro-pagefind": "^2.0.1",
		"clsx": "^2.1.1",
		"marked": "^18.1.0",
		"mermaid": "^12.1.0",
		"openapi-sampler": "^1.7.6",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"satori": "^0.46.0",
		"sharp": "^0.35.5",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/language-server": "^2.17.2",
		"@types/node": "^26.6.4",
		"astro": "^7.3.8",
		"oxlint": "^1.87.0",
		"prettier": "3.9.9",
		"prettier-plugin-astro": "1.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^7.0.0"
	},
	"peerDependencies": {
		"@pagefind/component-ui": "^1.5.0",
		"astro": "^7.0.0"
	}
}
