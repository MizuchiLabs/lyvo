---
import { Menu } from '@lucide/astro';
import ThemeToggle from '@lyvo/components/base/ThemeToggle.astro';
import ThemeSwitch from '@lyvo/components/base/ThemeSwitch.astro';
import Drawer from '@lyvo/components/base/Drawer.astro';
import BaseHead from '@lyvo/layouts/BaseHead.astro';
import SkipLink from '@lyvo/components/base/SkipLink.astro';
import Logo from '@lyvo/components/base/Logo.astro';
import Icon from '@lyvo/components/base/Icon.astro';
import Footer from '@lyvo/components/base/Footer.astro';
import config from 'virtual:lyvo-config';
import { isExternal } from '@lyvo/lib/utils';
import { websiteJsonLd } from '@lyvo/lib/seo';
import { getI18n } from '@lyvo/lib/i18n';
import { pageHref, stripBase } from '@lyvo/lib/url';

interface Props {
	title?: string;
	description?: string;
	/** Social image path or URL. Defaults to the generated site image. */
	image?: string;
	noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;

const { lang, t } = getI18n(Astro.url);
const isHome = stripBase(Astro.url.pathname).replace(/\/+$/, '') === '';

const navItems =
	config.nav.length > 0
		? config.nav
		: [
				{ title: t('docs'), href: pageHref(config.docs.prefix) },
				...(config.api.specs.length > 0
					? [{ title: t('api'), href: pageHref(config.api.root) }]
					: [])
			];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<BaseHead
		title={title}
		description={description}
		image={image}
		noindex={noindex}
		jsonLd={isHome ? [websiteJsonLd()] : []}
	/>

	<body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
		<SkipLink />
		<slot name="header">
			<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/60">
				<div class="container mx-auto flex h-14 max-w-screen-2xl items-center justify-between px-4 md:px-8">
					<div class="flex items-center gap-6">
						<Logo id="header" />
						<nav class="hidden items-center gap-1 md:flex">
							{navItems.map((item) => {
								const external = isExternal(item.href);
								return (
									<a
										href={item.href}
										target={external ? '_blank' : undefined}
										rel={external ? 'noopener noreferrer' : undefined}
										class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
									>
										{item.title}
									</a>
								);
							})}
						</nav>
					</div>
					<div class="flex items-center space-x-2">
						<slot name="header-actions" />
						{config.socials.map((social) => (
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								class="hidden rounded-full p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground md:block"
								title={social.label}
							>
								<span class="flex items-center justify-center [&>svg]:size-5">
									<Icon name={social.icon} />
								</span>
								<span class="sr-only">{social.label}</span>
							</a>
						))}
						<div class="hidden md:block">
							<ThemeToggle />
						</div>
						<button
							type="button"
							data-drawer-open
							class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none md:hidden"
						>
							<Menu size={18} />
							<span class="sr-only">{t('menu')}</span>
						</button>
					</div>
				</div>
			</header>
			<Drawer side="right">
				<nav class="flex flex-1 flex-col gap-0.5 overflow-y-auto px-3 py-4">
					{navItems.map((item) => {
						const external = isExternal(item.href);
						return (
							<a
								href={item.href}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
								class="rounded-md px-3 py-2.5 text-base font-medium text-foreground/80 transition-colors hover:bg-accent hover:text-foreground"
							>
								{item.title}
							</a>
						);
					})}
				</nav>
				<div class="flex shrink-0 items-center gap-1 border-t border-border/60 p-3">
					{config.socials.map((social) => (
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							title={social.label}
							class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground [&>svg]:size-4"
						>
							<Icon name={social.icon} size={16} />
							<span class="sr-only">{social.label}</span>
						</a>
					))}
					<div class="ml-auto">
						<ThemeSwitch />
					</div>
				</div>
			</Drawer>
		</slot>
		<main id="content" class="flex-1 overflow-x-clip">
			<slot />
		</main>
		<slot name="footer">
			<Footer />
		</slot>
	</body>
</html>
