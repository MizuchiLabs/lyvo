---
import ThemeToggle from '@lyvo/components/base/ThemeToggle.astro';
import BaseHead from '@lyvo/layouts/BaseHead.astro';
import Logo from '@lyvo/components/base/Logo.astro';
import Icon from '@lyvo/components/base/Icon.astro';
import Footer from '@lyvo/components/base/Footer.astro';
import config from 'virtual:lyvo-config';
import { isExternal } from '@lyvo/lib/utils';
import { localeFromPath, type RoutingInfo } from '@lyvo/lib/routing';

const routing: RoutingInfo = {
	docsPrefix: config.docs.prefix,
	apiRoot: config.api.root,
	defaultLocale: config.i18n.defaultLocale,
	locales: config.i18n.locales
};
const lang = localeFromPath(Astro.url.pathname, routing) ?? config.i18n.defaultLocale;

const navItems =
	config.nav ??
	[
		{ title: 'Docs', href: config.docs.prefix },
		...(config.api.specs.length > 0 ? [{ title: 'API', href: config.api.root }] : [])
	];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<BaseHead />

	<body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
		<slot name="header">
			<header
				class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-backdrop-filter:bg-background/60"
			>
				<div
					class="container mx-auto flex h-14 max-w-screen-2xl items-center justify-between px-4 md:px-8"
				>
					<div class="flex items-center gap-6">
						<Logo id="header" />
						<div class="hidden items-center gap-1 md:flex">
							{
								navItems.map((item) => {
									const external = isExternal(item.href);
									return (
										<a
											href={item.href}
											target={external ? '_blank' : undefined}
											rel={external ? 'noopener noreferrer' : undefined}
											class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
										>
											{item.title}
										</a>
									);
								})
							}
						</div>
					</div>
					<div class="flex items-center space-x-2">
						<slot name="header-actions" />
						{
							config.socials.map((social) => (
								<a
									href={social.href}
									target="_blank"
									rel="noopener noreferrer"
									class="rounded-full p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
									title={social.label}
								>
									<span class="flex items-center justify-center [&>svg]:size-5 [&>svg]:dark:invert">
										<Icon name={social.icon} />
									</span>
									<span class="sr-only">{social.label}</span>
								</a>
							))
						}
						<ThemeToggle />
					</div>
				</div>
			</header>
		</slot>
		<div class="flex-1">
			<slot />
		</div>
		<slot name="footer">
			<Footer />
		</slot>
	</body>
</html>
