---
import DocsLayout from '@lyvo/layouts/DocsLayout.astro';
import {
	apiIndexHref,
	findEndpoint,
	findSchema,
	readAllApiSpecs,
	type LoadedApiSpec
} from '@lyvo/lib/openapi/model';
import ApiOverview from '@lyvo/components/openapi/ApiOverview.astro';
import ApiEndpoint from '@lyvo/components/openapi/ApiEndpoint.astro';
import SchemaPage from '@lyvo/components/openapi/SchemaPage.astro';
import { joinUrl } from '@lyvo/lib/routing';
import { endpointDescription, summarize } from '@lyvo/lib/markdown';
import { t } from '@lyvo/lib/i18n';

type Page =
	| { kind: 'overview'; spec: LoadedApiSpec }
	| { kind: 'endpoint'; spec: LoadedApiSpec; slug: string }
	| { kind: 'schema'; spec: LoadedApiSpec; slug: string };

export async function getStaticPaths() {
	const paths: Array<{ params: { slug: string | undefined }; props: { page: Page } }> = [];
	for (const spec of await readAllApiSpecs()) {
		const slug = (...parts: string[]) => joinUrl(spec.sub, ...parts).slice(1) || undefined;
		paths.push({ params: { slug: slug() }, props: { page: { kind: 'overview', spec } } });
		for (const endpoint of [...spec.model.operations, ...spec.model.webhooks]) {
			paths.push({
				params: { slug: slug(endpoint.slug) },
				props: { page: { kind: 'endpoint', spec, slug: endpoint.slug } }
			});
		}
		for (const schema of spec.model.schemas) {
			paths.push({
				params: { slug: slug('schemas', schema.slug) },
				props: { page: { kind: 'schema', spec, slug: schema.slug } }
			});
		}
	}
	return paths;
}

const { page } = Astro.props as { page: Page };
const { spec } = page;
const info = spec.model.info;
const specCrumb = { title: info.title ?? spec.title, href: apiIndexHref(spec) };

const endpoint = page.kind === 'endpoint' ? findEndpoint(spec.model, page.slug) : null;
const schema = page.kind === 'schema' ? findSchema(spec.model, page.slug) : null;

const title = endpoint?.title ?? schema?.name ?? info.title ?? spec.title;
const description = endpoint
	? endpointDescription(endpoint)
	: summarize(schema?.description ?? info.description) || 'API reference.';
const crumbs =
	page.kind === 'overview'
		? []
		: page.kind === 'schema'
			? [specCrumb, { title: t('schemas'), href: specCrumb.href }]
			: [specCrumb];
---

<DocsLayout title={title} description={description} isApi={true} crumbs={crumbs}>
	{page.kind === 'overview' && <ApiOverview spec={spec} />}
	{page.kind === 'endpoint' && <ApiEndpoint spec={spec} slug={page.slug} />}
	{page.kind === 'schema' && schema && <SchemaPage spec={spec} entry={schema} />}
</DocsLayout>
