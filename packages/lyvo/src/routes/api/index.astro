---
import DocsLayout from '@lyvo/layouts/DocsLayout.astro';
import { tryReadOpenAPIModel } from '@lyvo/lib/openapi/model';
import type { OpenAPISecurityRequirement } from '@lyvo/lib/openapi/types';
import { marked } from 'marked';
import {
	Download,
	Server,
	Shield,
	Tags as TagsIcon,
	Mail,
	Scale,
	FileText,
	ExternalLink,
	Link as LinkIcon,
	Info
} from '@lucide/astro';
import { staticRedirect } from '@lyvo/lib/utils';

const model = await tryReadOpenAPIModel();

if (!model) {
	return staticRedirect('/404');
}

const source = model.source;
const downloadHref = source?.startsWith('public/')
	? `/${source.replace(/^public\//, '')}`
	: source
		? `/${source}`
		: '';

function schemeBadge(scheme: OpenAPISecurityRequirement): string {
	switch (scheme.type) {
		case 'http':
			return scheme.scheme === 'bearer' ? 'HTTP · Bearer' : `HTTP · ${scheme.scheme ?? ''}`.trim();
		case 'apiKey':
			return `API Key · ${scheme.in ?? ''}`.trim();
		case 'oauth2':
			return 'OAuth 2.0';
		case 'openIdConnect':
			return 'OpenID Connect';
		case 'mutualTLS':
			return 'Mutual TLS';
		default:
			return scheme.type ?? 'Scheme';
	}
}
---

<DocsLayout
	title={model.info?.title ?? 'API Overview'}
	description={model.info?.description ?? 'Overview of the API documentation.'}
	isApi={true}
>
	<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 md:py-12 lg:px-8 xl:px-12">
		<div class="mb-10 space-y-6">
			{/* Header */}
			<div class="flex flex-wrap items-start justify-between gap-4">
				<div class="min-w-0 space-y-3">
					<div class="flex flex-wrap items-center gap-3">
						<h1 class="scroll-m-20 text-3xl font-bold tracking-tight md:text-4xl">
							{model.info?.title ?? 'API Reference'}
						</h1>
						{model.info?.version && (
							<span class="mt-1 rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-xs font-semibold tracking-wide text-primary uppercase">
								v{model.info.version}
							</span>
						)}
						{model.openapi && (
							<span class="mt-1 rounded-full border border-border bg-muted/40 px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
								OpenAPI {model.openapi}
							</span>
						)}
					</div>

					{model.info?.description && (
						<div
							class="prose max-w-none prose-slate dark:prose-invert prose-headings:scroll-m-20 prose-a:text-primary prose-a:no-underline hover:prose-a:underline"
							set:html={await marked.parse(model.info.description as string)}
						/>
					)}
				</div>

				{downloadHref && (
					<a
						href={downloadHref}
						download
						class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none"
					>
						<Download size={16} />
						Download OpenAPI
					</a>
				)}
			</div>

			{/* Servers */}
			{model.servers.length > 0 && (
				<section class="rounded-lg border border-border bg-card p-6 text-card-foreground shadow-sm">
					<div class="mb-4 flex items-center gap-2">
						<Server size={16} class="text-muted-foreground" />
						<h2 class="text-base font-semibold tracking-tight">Servers</h2>
						<span class="text-sm text-muted-foreground">
							({model.servers.length})
						</span>
					</div>
					<ul class="divide-y divide-border/70">
						{model.servers.map((server) => (
							<li class="py-3 first:pt-0 last:pb-0">
								<code class="block break-all rounded-md bg-muted/40 px-2 py-1 text-sm text-foreground">
									{server.url}
								</code>
								{server.description && (
									<p class="mt-1.5 pl-2 text-sm text-muted-foreground">
										{server.description}
									</p>
								)}
							</li>
						))}
					</ul>
				</section>
			)}

			{/* Authentication + About grid */}
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
				{model.securitySchemes.length > 0 && (
					<section class="rounded-lg border border-border bg-card p-6 text-card-foreground shadow-sm">
						<div class="mb-4 flex items-center gap-2">
							<Shield size={16} class="text-muted-foreground" />
							<h2 class="text-base font-semibold tracking-tight">Authentication</h2>
						</div>
						<ul class="space-y-3">
							{model.securitySchemes.map((scheme) => (
								<li
									class="rounded-md border border-border/70 px-3 py-2.5 transition-colors hover:bg-muted/30"
								>
									<div class="flex items-center justify-between gap-3">
										<span class="truncate font-mono text-sm font-medium">
											{scheme.name}
										</span>
										<span class="shrink-0 rounded border border-border bg-muted/40 px-1.5 py-0.5 text-[10px] leading-4 font-semibold tracking-wide text-muted-foreground uppercase">
											{schemeBadge(scheme)}
										</span>
									</div>
									{scheme.description && (
										<p class="mt-1 text-sm text-muted-foreground">
											{scheme.description}
										</p>
									)}
								</li>
							))}
						</ul>
					</section>
				)}

				{(model.info?.contact || model.info?.license || model.info?.termsOfService) && (
					<section class="rounded-lg border border-border bg-card p-6 text-card-foreground shadow-sm">
						<div class="mb-4 flex items-center gap-2">
							<Info size={16} class="text-muted-foreground" />
							<h2 class="text-base font-semibold tracking-tight">About</h2>
						</div>
						<dl class="space-y-4 text-sm">
							{model.info.contact && (
								<div>
									<dt class="flex items-center gap-1.5 text-xs font-medium tracking-wide text-muted-foreground uppercase">
										<Mail size={12} />
										Contact
									</dt>
									<dd class="mt-1">
										{model.info.contact.name ? (
											<span class="font-medium">{model.info.contact.name}</span>
										) : (
											'—'
										)}
										{model.info.contact.email && (
											<a
												href={`mailto:${model.info.contact.email}`}
												class="ml-2 text-primary hover:underline"
											>
												{model.info.contact.email}
											</a>
										)}
										{model.info.contact.url && (
											<a
												href={model.info.contact.url}
												target="_blank"
												rel="noopener noreferrer"
												class="ml-2 inline-flex items-center gap-1 text-primary hover:underline"
											>
												Website
												<ExternalLink size={12} />
											</a>
										)}
									</dd>
								</div>
							)}

							{model.info.license && (
								<div>
									<dt class="flex items-center gap-1.5 text-xs font-medium tracking-wide text-muted-foreground uppercase">
										<Scale size={12} />
										License
									</dt>
									<dd class="mt-1">
										<a
											href={model.info.license.url}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-1 font-medium text-primary hover:underline"
										>
											{model.info.license.name}
											{model.info.license.url && <ExternalLink size={12} />}
										</a>
										{model.info.license.identifier && (
											<span class="ml-2 text-muted-foreground">
												{model.info.license.identifier}
											</span>
										)}
									</dd>
								</div>
							)}

							{model.info.termsOfService && (
								<div>
									<dt class="flex items-center gap-1.5 text-xs font-medium tracking-wide text-muted-foreground uppercase">
										<FileText size={12} />
										Terms of Service
									</dt>
									<dd class="mt-1">
										<a
											href={model.info.termsOfService}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-1 font-medium text-primary hover:underline"
										>
											Read terms
											<ExternalLink size={12} />
										</a>
									</dd>
								</div>
							)}

							{model.externalDocs && (
								<div>
									<dt class="flex items-center gap-1.5 text-xs font-medium tracking-wide text-muted-foreground uppercase">
										<LinkIcon size={12} />
										Documentation
									</dt>
									<dd class="mt-1">
										<a
											href={model.externalDocs.url}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-1 font-medium text-primary hover:underline"
										>
											{model.externalDocs.description ?? 'External docs'}
											<ExternalLink size={12} />
										</a>
									</dd>
								</div>
							)}
						</dl>
					</section>
				)}
			</div>

			{/* Tags */}
			{model.tags.length > 0 && (
				<section class="rounded-lg border border-border bg-card p-6 text-card-foreground shadow-sm">
					<div class="mb-4 flex items-center gap-2">
						<TagsIcon size={16} class="text-muted-foreground" />
						<h2 class="text-base font-semibold tracking-tight">Groups</h2>
						<span class="text-sm text-muted-foreground">({model.tags.length})</span>
					</div>
					<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
						{model.tags.map((tag) => (
							<li
								class="rounded-md border border-border/70 px-3 py-2.5 transition-colors hover:bg-muted/30"
							>
								<div class="flex items-center justify-between gap-3">
									<span class="truncate text-sm font-medium">{tag.name}</span>
									<span class="shrink-0 text-xs text-muted-foreground">
										{tag.operationCount} {tag.operationCount === 1 ? 'endpoint' : 'endpoints'}
									</span>
								</div>
								{tag.description && (
									<p class="mt-1 text-sm text-muted-foreground">
										{tag.description}
									</p>
								)}
							</li>
						))}
					</ul>
				</section>
			)}
		</div>
	</div>
</DocsLayout>
