---
import { getDocsHierarchy, getFirstDoc, docUrl } from '@lyvo/lib/docs';
import DocsPage from '@lyvo/components/docs/DocsPage.astro';
import Redirect from '@lyvo/components/base/Redirect.astro';

export async function getStaticPaths() {
	const paths = [{ params: { slug: undefined }, props: {} }];
	const { docs } = await getDocsHierarchy(null);
	for (const doc of docs) {
		paths.push({ params: { slug: doc.id }, props: { entry: doc } });
	}
	return paths;
}

const { slug } = Astro.params;

async function resolveEntry(slug: string | undefined) {
	if (slug === undefined) {
		const first = await getFirstDoc();
		if (first) return { redirect: docUrl(first.id), entry: null };
	}
	const { docs } = await getDocsHierarchy(null);
	return { redirect: null, entry: docs.find((doc) => doc.id === slug) ?? null };
}

const { redirect, entry } = await resolveEntry(slug);
---

{
	redirect ? (
		<Redirect to={redirect} />
	) : entry ? (
		<DocsPage entry={entry} />
	) : (
		<DocsPage entry={undefined} notFound={true} />
	)
}
