---
import { Image } from 'astro:assets';
import config from 'virtual:lyvo-config';

interface Props {
	size?: number;
	id?: string;
}

const { size = 28, id: propId } = Astro.props;
const id = propId ?? `logo-${crypto.randomUUID().slice(0, 8)}`;

const images = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/*.{svg,png,jpg,jpeg,webp,avif,gif}'
);

async function resolveLogo(name: string) {
	const key = Object.keys(images).find((k) => {
		const fileName = k.split('/').pop();
		return fileName === name || fileName?.startsWith(`${name}.`);
	});
	return key ? (await images[key]()).default : null;
}

let lightVariant = 'logo.svg';
let darkVariant = 'logo.svg';

if (typeof config.logo === 'string') {
	lightVariant = config.logo;
	darkVariant = config.logo;
} else if (config.logo && typeof config.logo === 'object') {
	lightVariant = config.logo.light;
	darkVariant = config.logo.dark;
}

const lightLogo = await resolveLogo(lightVariant);
const darkLogo = darkVariant !== lightVariant ? await resolveLogo(darkVariant) : lightLogo;
---

<a
	href="/"
	id={id}
	class="flex items-center gap-2.5 text-lg font-bold tracking-tight transition-opacity hover:opacity-80"
>
	{
		lightLogo ? (
			<>
				{/* LIGHT MODE LOGO */}
				<Image
					src={lightLogo}
					alt={`${config.title} Logo`}
					width={size}
					densities={[1.5, 2]}
					style={`width: ${size}px;`}
					class={`object-contain ${darkLogo !== lightLogo ? 'block dark:hidden' : ''}`}
				/>

				{/* DARK MODE LOGO (Only renders if it's a different file) */}
				{darkLogo !== lightLogo && darkLogo && (
					<Image
						src={darkLogo}
						alt={`${config.title} Dark Logo`}
						width={size}
						densities={[1.5, 2]}
						style={`width: ${size}px;`}
						class="hidden object-contain dark:block"
					/>
				)}
			</>
		) : (
			<span
				class="inline-flex size-7 items-center justify-center rounded-md bg-primary font-mono text-sm font-bold text-primary-foreground"
				aria-hidden="true"
			>
				{(config.title ?? 'D').charAt(0).toUpperCase()}
			</span>
		)
	}
	{config.title?.length ? <span>{config.title}</span> : null}
</a>
