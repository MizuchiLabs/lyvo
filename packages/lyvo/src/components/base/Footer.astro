---
import Logo from '@lyvo/components/base/Logo.astro';
import Icon from '@lyvo/components/base/Icon.astro';
import config from 'virtual:lyvo-config';
import { isExternal } from '@lyvo/lib/utils';

const year = new Date().getFullYear();
const columns = config.footer?.columns ?? [];
const hasContent = columns.length > 0 || config.socials.length > 0;
---

{
	hasContent && (
		<footer class="border-t border-border/40">
			<div class="container mx-auto max-w-screen-2xl px-4 py-10 md:px-8">
				<div class="flex flex-col justify-between gap-10 md:flex-row">
					<div class="max-w-sm space-y-4">
						<Logo id="footer" />
						{config.footer?.note && (
							<p class="text-sm text-muted-foreground">{config.footer.note}</p>
						)}
						{config.socials.length > 0 && (
							<div class="flex items-center gap-1">
								{config.socials.map((social) => (
									<a
										href={social.href}
										target="_blank"
										rel="noopener noreferrer"
										class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
										title={social.label}
									>
										<span class="flex items-center justify-center [&>svg]:size-5 [&>svg]:dark:invert">
											<Icon name={social.icon} />
										</span>
										<span class="sr-only">{social.label}</span>
									</a>
								))}
							</div>
						)}
					</div>

					{
						columns.length > 0 && (
							<div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
								{columns.map((column) => (
									<div class="space-y-3">
										<h3 class="text-sm font-semibold">{column.title}</h3>
										<ul class="space-y-2">
											{column.links.map((link) => {
												const external = isExternal(link.href);
												return (
													<li>
														<a
															href={link.href}
															target={external ? '_blank' : undefined}
															rel={external ? 'noopener noreferrer' : undefined}
															class="text-sm text-muted-foreground transition-colors hover:text-foreground"
														>
															{link.label}
														</a>
													</li>
												);
											})}
										</ul>
									</div>
								))}
							</div>
						)
					}
				</div>

				<div class="mt-10 border-t border-border/40 pt-6 text-xs text-muted-foreground">
					© {year}
					{config.title ? ` ${config.title}` : ''}. All rights reserved.
				</div>
			</div>
		</footer>
	)
}
