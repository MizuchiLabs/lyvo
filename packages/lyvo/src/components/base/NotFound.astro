---
import { Compass } from '@lucide/astro';
import { t } from '@lyvo/lib/i18n';

interface Props {
	title?: string;
	text?: string;
}

const { title, text } = Astro.props;
---

<div class="flex min-h-[50vh] flex-col items-center justify-center gap-4 px-6 py-16 text-center">
	<div class="rounded-full border border-border bg-muted/40 p-4 text-muted-foreground">
		<Compass size={28} />
	</div>
	<h1 class="text-2xl font-bold tracking-tight">{title ?? t('notFoundTitle')}</h1>
	<p class="max-w-md text-sm text-muted-foreground">
		{text ?? t('notFoundText')}
	</p>
	<a
		href="/"
		class="mt-2 inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
	>
		{t('backHome')}
	</a>
</div>
