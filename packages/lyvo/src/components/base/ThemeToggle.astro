---
import { Sun, Moon } from '@lucide/astro';
import { getI18n } from '@lyvo/lib/i18n';

const { t } = getI18n(Astro.url);
---

<theme-toggle {...Astro.props}>
	<button
		class="inline-flex size-11 items-center justify-center rounded-full p-2 text-sm font-medium whitespace-nowrap transition-colors hover:bg-accent hover:text-accent-foreground md:size-9"
		title={t('toggleTheme')}
	>
		<Sun class="size-5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
		<Moon class="absolute size-5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
		<span class="sr-only">{t('toggleTheme')}</span>
	</button>
</theme-toggle>

<script>
	class ThemeToggle extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector('button');

			if (button) {
				button.addEventListener('click', () => {
					const isDark = document.documentElement.classList.contains('dark');
					window.__lyvoTheme?.set(isDark ? 'light' : 'dark');
				});
			}
		}
	}

	if (!customElements.get('theme-toggle')) {
		customElements.define('theme-toggle', ThemeToggle);
	}
</script>
