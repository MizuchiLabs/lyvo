---
interface Props {
	domain: string;
	src?: string;
}
const { domain, src = 'https://plausible.io/js/script.js' } = Astro.props;
---

<script is:inline defer data-domain={domain} src={src}></script>

<script is:inline>
	// Queue shim so events fired before the deferred script loads are not dropped.
	// The real script replays window.plausible.q on load.
	window.plausible =
		window.plausible ||
		function () {
			(window.plausible.q = window.plausible.q || []).push(arguments);
		};
</script>
