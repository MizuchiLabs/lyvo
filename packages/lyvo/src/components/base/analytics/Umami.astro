---
interface Props {
	websiteId: string;
	src: string;
	domains?: string;
}
const { websiteId, src, domains } = Astro.props;
---

<!-- Honors Do Not Track and never records query strings or hashes. -->
<script
	is:inline
	defer
	src={src}
	data-website-id={websiteId}
	data-domains={domains}
	data-do-not-track="true"
	data-exclude-search="true"
	data-exclude-hash="true"
></script>
