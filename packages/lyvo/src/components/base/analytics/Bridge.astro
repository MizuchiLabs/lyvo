<!-- Forwards lyvo:track events to whichever analytics provider is loaded. -->
<script>
	type Detail = { name: string; props: Record<string, string | number | boolean> };

	window.addEventListener('lyvo:track', (event) => {
		const { name, props } = (event as CustomEvent<Detail>).detail;
		const w = window as any;
		// Umami and Plausible only take string properties.
		const strings = Object.fromEntries(
			Object.entries(props).map(([key, value]) => [key, String(value)])
		);

		if (w.umami?.track) w.umami.track(name, strings);
		if (typeof w.plausible === 'function') w.plausible(name, { props: strings });
		if (w.posthog?.capture) w.posthog.capture(name, props);
		if (w._paq?.push) {
			w._paq.push(['trackEvent', 'lyvo', name, String(props.path ?? location.pathname)]);
		}
	});
</script>
