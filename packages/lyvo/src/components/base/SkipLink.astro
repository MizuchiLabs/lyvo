---
import { getI18n } from '@lyvo/lib/i18n';

const { t } = getI18n(Astro.url);
---

<a
	href="#content"
	class="sr-only z-100 rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-foreground shadow-lg focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
>
	{t('skipToContent')}
</a>
