---
import * as lucide from '@lucide/astro';

interface Props {
	/** File name in src/assets (with or without .svg) or a Lucide icon name like "zap". */
	name: string;
	class?: string;
	size?: number;
}

const { name, class: className, size = 20 } = Astro.props;

const svgs = import.meta.glob<string>('/src/assets/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true
});

const svgKey = Object.keys(svgs).find(
	(key) => key.endsWith(`/${name}`) || key.endsWith(`/${name}.svg`)
);
const svg = svgKey ? svgs[svgKey] : null;
const rendered =
	svg && className ? svg.replace(/<svg([^>]*)>/, `<svg class="${className}"$1>`) : svg;

const pascal = name
	.replace(/\.svg$/, '')
	.split(/[-_\s]+/)
	.map((part) => part.charAt(0).toUpperCase() + part.slice(1))
	.join('');
const LucideIcon = svg ? null : (lucide as Record<string, any>)[pascal];
---

{rendered ? (
	<Fragment set:html={rendered} />
) : LucideIcon ? (
	<LucideIcon size={size} class={className} />
) : (
	<span>{name}</span>
)}
