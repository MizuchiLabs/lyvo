---
import { getI18n } from '@lyvo/lib/i18n';

interface Props {
	/** Icon-only button for the mobile bar. */
	compact?: boolean;
}

const { compact = false } = Astro.props;
const placeholder = getI18n(Astro.url).t('search');
---

{compact ? (
	<pagefind-modal-trigger
		compact
		hide-shortcut
		placeholder={placeholder}
		class="pagefind-header-trigger"
	></pagefind-modal-trigger>
) : (
	<pagefind-modal-trigger
		placeholder={placeholder}
		class="lyvo-search-trigger"
	></pagefind-modal-trigger>
)}
