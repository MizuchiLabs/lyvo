---
import { Webhook } from '@lucide/astro';
import CopyButton from '@lyvo/components/base/CopyButton.astro';
import type { OpenAPIOperation } from '@lyvo/lib/openapi/types';
import { methodColor } from '@lyvo/lib/openapi/methods';
import { getI18n } from '@lyvo/lib/i18n';

interface Props {
	endpoint: OpenAPIOperation;
	isWebhook: boolean;
}

const { endpoint, isWebhook } = Astro.props;
const { t } = getI18n(Astro.url);

const methodLabel = endpoint.method.toUpperCase();
const baseUrl =
	endpoint.servers && endpoint.servers.length > 0
		? endpoint.servers[0].url.replace(/\/$/, '')
		: '';
const fullUrl = `${baseUrl}${endpoint.path}`;
---

<div class="flex flex-wrap items-center gap-2 sm:gap-3">
	{isWebhook ? (
		<span class="inline-flex items-center gap-1.5 rounded-md border border-fuchsia-500/30 bg-fuchsia-500/10 px-2.5 py-1 text-xs font-semibold tracking-wide text-fuchsia-600 uppercase dark:text-fuchsia-300">
			<Webhook size={14} />
			{methodLabel}
		</span>
	) : (
		<span
			class:list={[
				'rounded-md border px-2.5 py-1 text-xs font-semibold tracking-wide uppercase',
				methodColor[endpoint.method]
			]}
		>
			{methodLabel}
		</span>
	)}

	<div class="flex min-w-0 flex-1 items-center gap-1 rounded-md border border-border/70 bg-muted/40 px-1 py-1 sm:gap-2">
		<code class="no-scrollbar min-w-0 flex-1 overflow-auto px-2 py-1 text-sm font-medium whitespace-nowrap">
			{baseUrl ? <span class="text-muted-foreground/70 select-none">{baseUrl}</span> : null}
			<span class="ml-0.5 text-foreground">{endpoint.path}</span>
		</code>

		<CopyButton
			text={fullUrl}
			label={t('copyUrl')}
			class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted-foreground/20 hover:text-foreground"
		/>
	</div>
</div>
