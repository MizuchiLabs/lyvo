---
import Icon from '@lyvo/components/base/Icon.astro';
import { pageHref } from '@lyvo/lib/url';
import { isExternal } from '@lyvo/lib/utils';

interface Logo {
	name: string;
	/** Image URL, or leave out and use `icon` for an SVG in src/assets. */
	src?: string;
	icon?: string;
	href?: string;
}

interface Props {
	title?: string;
	logos: Logo[];
}

const { title, logos } = Astro.props;
---

<section class="container mx-auto max-w-5xl px-4 py-12 md:px-8">
	{title && <p class="mb-8 text-center text-sm font-medium text-muted-foreground">{title}</p>}
	<ul class="flex flex-wrap items-center justify-center gap-x-12 gap-y-8">
		{logos.map((logo) => {
			const content = logo.src ? (
				<img src={logo.src} alt={logo.name} class="h-7 w-auto" loading="lazy" />
			) : logo.icon ? (
				<span class="flex items-center gap-2 text-lg font-semibold [&>svg]:h-7 [&>svg]:w-auto">
					<Icon name={logo.icon} size={28} />
					<span class="sr-only">{logo.name}</span>
				</span>
			) : (
				<span class="text-lg font-semibold tracking-tight">{logo.name}</span>
			);
			return (
				<li class="text-muted-foreground opacity-70 grayscale transition hover:text-foreground hover:opacity-100 hover:grayscale-0">
					{logo.href ? (
						<a
							href={pageHref(logo.href)}
							target={isExternal(logo.href) ? '_blank' : undefined}
							rel={isExternal(logo.href) ? 'noopener noreferrer' : undefined}
						>
							{content}
						</a>
					) : (
						content
					)}
				</li>
			);
		})}
	</ul>
</section>
