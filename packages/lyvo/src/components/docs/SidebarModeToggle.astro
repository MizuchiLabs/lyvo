---
import { tryReadDefaultApiModel } from '@lyvo/lib/openapi/model';
import { cn } from '@lyvo/lib/utils';
import { BookOpen, Terminal } from '@lucide/astro';
import { t } from '@lyvo/lib/i18n';
import config from 'virtual:lyvo-config';

const openapiModel = await tryReadDefaultApiModel();
const hasApiMode =
	(openapiModel?.operations?.length ?? 0) + (openapiModel?.webhooks?.length ?? 0) > 0;

const currentPath = Astro.url.pathname;
const activeMode = hasApiMode && currentPath.startsWith(config.api.root) ? 'api' : 'docs';
---

{
	hasApiMode && (
		<div class="px-6">
			<div class="flex items-center justify-between rounded-lg bg-muted/40 p-0.5 ring-1 ring-border/50 ring-inset">
				<a
					href={config.docs.prefix}
					class={cn(
						'flex w-full items-center justify-center gap-2 rounded-md px-2 py-1.5 text-xs font-semibold transition-all duration-200',
						activeMode === 'docs'
							? 'bg-background text-foreground shadow-sm ring-1 ring-border/50'
							: 'text-muted-foreground hover:bg-muted/60 hover:text-foreground'
					)}
				>
					<BookOpen size={14} />
					{t('guides')}
				</a>
				<a
					href={config.api.root}
					class={cn(
						'flex w-full items-center justify-center gap-2 rounded-md px-2 py-1.5 text-xs font-semibold transition-all duration-200',
						activeMode === 'api'
							? 'bg-background text-foreground shadow-sm ring-1 ring-border/50'
							: 'text-muted-foreground hover:bg-muted/60 hover:text-foreground'
					)}
				>
					<Terminal size={14} />
					{t('reference')}
				</a>
			</div>
		</div>
	)
}
