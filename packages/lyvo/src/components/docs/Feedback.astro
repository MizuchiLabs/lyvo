---
import { ThumbsUp, ThumbsDown, Check, ArrowUpRight } from '@lucide/astro';
import config from 'virtual:lyvo-config';
import { t } from '@lyvo/lib/i18n';
import { currentLocale } from '@lyvo/lib/docs';
import { getIssueURL } from '@lyvo/lib/repo';
import { absoluteUrl } from '@lyvo/lib/seo';

interface Props {
	title?: string;
}

const { title = '' } = Astro.props;
const locale = currentLocale(Astro.url.pathname) ?? config.i18n.defaultLocale;
const pageUrl = absoluteUrl(Astro.url.pathname) ?? Astro.url.pathname;
const issueUrl = config.repo
	? getIssueURL(config.repo.url, `Docs feedback: ${title}`, `Page: ${pageUrl}\n\n`)
	: null;
// A comment box only makes sense when something receives it.
const askComment = Boolean(config.analytics);

const buttonClass =
	'feedback-btn inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none';
---

{config.docs.feedback && (
	<div class="feedback-widget min-w-0" data-locale={locale} data-state="ask">
		<div class="feedback-ask flex flex-wrap items-center gap-3">
			<span class="text-sm font-medium text-muted-foreground">{t('helpful', locale)}</span>
			<div class="flex items-center gap-2">
				<button type="button" data-helpful="true" class={buttonClass}>
					<ThumbsUp size={15} />
					{t('yes', locale)}
				</button>
				<button type="button" data-helpful="false" class={buttonClass}>
					<ThumbsDown size={15} />
					{t('no', locale)}
				</button>
			</div>
		</div>

		<form class="feedback-comment hidden w-full max-w-lg space-y-2" data-astro-reload>
			{askComment && (
				<>
					<label for="feedback-text" class="block text-sm font-medium">
						{t('feedbackQuestion', locale)}
					</label>
					<textarea
						id="feedback-text"
						name="comment"
						rows="3"
						maxlength="500"
						placeholder={t('feedbackPlaceholder', locale)}
						class="w-full resize-y rounded-lg border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground/70 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
					></textarea>
				</>
			)}
			<div class="flex flex-wrap items-center gap-2">
				{askComment && (
					<>
						<button
							type="submit"
							class="inline-flex h-8 items-center rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
						>
							{t('send', locale)}
						</button>
						<button
							type="button"
							data-skip
							class="inline-flex h-8 items-center rounded-md px-3 text-sm text-muted-foreground hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
						>
							{t('skip', locale)}
						</button>
					</>
				)}
				{issueUrl && (
					<a
						href={issueUrl}
						target="_blank"
						rel="noopener noreferrer"
						data-issue
						class="group/issue inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground"
					>
						{t(askComment ? 'orOpenIssue' : 'openIssue', locale)}
						<ArrowUpRight
							size={14}
							class="transition-transform group-hover/issue:translate-x-0.5 group-hover/issue:-translate-y-0.5"
						/>
					</a>
				)}
			</div>
		</form>

		<p class="feedback-thanks hidden items-center gap-2 text-sm text-muted-foreground">
			<Check size={16} class="text-primary" />
			{t('thanks', locale)}
		</p>
	</div>
)}

<style>
	.feedback-widget[data-state='comment'] {
		flex-basis: 100%;
	}
	.feedback-widget[data-state='comment'] .feedback-ask,
	.feedback-widget[data-state='done'] .feedback-ask {
		display: none;
	}
	.feedback-widget[data-state='comment'] .feedback-comment {
		display: block;
		animation: feedback-in 0.25s ease both;
	}
	.feedback-widget[data-state='done'] .feedback-thanks {
		display: flex;
		animation: feedback-in 0.3s ease both;
	}
	@keyframes feedback-in {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.feedback-widget * {
			animation: none !important;
		}
	}
</style>

<script>
	import { track } from '@lyvo/lib/track';

	const storageKey = () => `lyvo-feedback:${location.pathname}`;

	function remember() {
		try {
			localStorage.setItem(storageKey(), '1');
		} catch {
			// storage blocked, the widget just asks again next time
		}
	}

	function alreadyVoted(): boolean {
		try {
			return localStorage.getItem(storageKey()) !== null;
		} catch {
			return false;
		}
	}

	function send(widget: HTMLElement, helpful: boolean, comment?: string) {
		const detail = {
			helpful,
			path: location.pathname,
			title: document.title,
			locale: widget.dataset.locale ?? '',
			comment
		};
		track(comment ? 'docs_feedback_comment' : 'docs_feedback', {
			helpful,
			path: detail.path,
			locale: detail.locale,
			comment
		});
		window.dispatchEvent(new CustomEvent('lyvo:feedback', { detail }));
	}

	function init() {
		for (const widget of document.querySelectorAll<HTMLElement>('.feedback-widget')) {
			if (alreadyVoted()) widget.dataset.state = 'done';
		}
	}

	document.addEventListener('click', (event) => {
		const target = event.target as Element;
		const widget = target.closest<HTMLElement>('.feedback-widget');
		if (!widget) return;

		const vote = target.closest<HTMLButtonElement>('[data-helpful]');
		if (vote) {
			const helpful = vote.dataset.helpful === 'true';
			send(widget, helpful);
			remember();
			const hasFollowUp = widget.querySelector('.feedback-comment textarea, [data-issue]');
			widget.dataset.state = !helpful && hasFollowUp ? 'comment' : 'done';
			if (widget.dataset.state === 'comment') widget.querySelector('textarea')?.focus();
			return;
		}

		if (target.closest('[data-skip], [data-issue]')) widget.dataset.state = 'done';
	});

	document.addEventListener('submit', (event) => {
		const form = event.target as HTMLFormElement;
		const widget = form.closest<HTMLElement>('.feedback-widget');
		if (!widget) return;
		event.preventDefault();
		const comment = String(new FormData(form).get('comment') ?? '').trim();
		if (comment) send(widget, false, comment);
		widget.dataset.state = 'done';
	});

	document.addEventListener('astro:page-load', init);
</script>
