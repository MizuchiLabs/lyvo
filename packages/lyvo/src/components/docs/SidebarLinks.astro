---
import { Webhook, LayoutGrid } from '@lucide/astro';
import SidebarGroup from '@lyvo/components/docs/SidebarGroup.astro';
import SidebarNavItems from '@lyvo/components/docs/SidebarNavItems.astro';
import { getDocsHierarchy, currentLocale } from '@lyvo/lib/docs';
import { apiIndexHref, apiPageHref, schemaHref } from '@lyvo/lib/openapi/model';
import type { Section } from '@lyvo/lib/sections';
import { t } from '@lyvo/lib/i18n';
import { cn } from '@lyvo/lib/utils';

interface Props {
	section: Section;
	animate?: boolean;
}

const { section, animate = false } = Astro.props;

const methodClassMap = {
	get: 'text-emerald-600 dark:text-emerald-400',
	post: 'text-blue-600 dark:text-blue-400',
	put: 'text-amber-600 dark:text-amber-400',
	patch: 'text-yellow-600 dark:text-yellow-300',
	delete: 'text-rose-600 dark:text-rose-400',
	head: 'text-violet-600 dark:text-violet-300',
	options: 'text-cyan-600 dark:text-cyan-400',
	trace: 'text-fuchsia-600 dark:text-fuchsia-400'
} as const;

const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const locale = currentLocale(currentPath);
const spec = section.spec;
const nav = spec ? [] : (await getDocsHierarchy(locale)).nav;

const isActiveHref = (href: string) => currentPath === href.replace(/\/+$/, '');
const vtName = animate ? 'view-transition-name: lyvo-sidebar-active' : undefined;
const overviewHref = spec ? apiIndexHref(spec) : '';

const linkClass = (active: boolean) =>
	cn(
		'group/link relative flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors select-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none',
		active
			? 'font-medium text-primary'
			: 'text-muted-foreground hover:bg-accent/60 hover:text-foreground'
	);
---

<nav
	class="sidebar-scroll no-scrollbar min-h-0 flex-1 overflow-y-auto px-3 py-4"
	data-sidebar-scroll
	aria-label={section.title}
>
	<div class="flex flex-col gap-0.5">
		{spec ? (
			<Fragment>
				<a
					href={overviewHref}
					class={linkClass(isActiveHref(overviewHref))}
					aria-current={isActiveHref(overviewHref) ? 'page' : undefined}
				>
					{isActiveHref(overviewHref) && (
						<span
							aria-hidden="true"
							class="absolute inset-0 rounded-md bg-primary/10"
							style={vtName}
						/>
					)}
					<LayoutGrid size={16} class="relative size-4 shrink-0 opacity-80" />
					<span class="relative">{t('overview', locale)}</span>
				</a>
				<div class="h-3" />
				{spec.model.navigation.map((group) => (
					<SidebarGroup
						title={group.title}
						dataGroupId={`api-${spec.specId}-${group.id}`}
						isActive={group.items.some((endpoint) =>
							isActiveHref(apiPageHref(spec, endpoint.slug))
						)}
					>
						{group.items.map((endpoint) => {
							const href = apiPageHref(spec, endpoint.slug);
							const active = isActiveHref(href);
							return (
								<a
									href={href}
									class={linkClass(active)}
									title={`${endpoint.method.toUpperCase()} ${endpoint.path}`}
									aria-current={active ? 'page' : undefined}
								>
									{active && (
										<span
											aria-hidden="true"
											class="absolute inset-0 rounded-md bg-primary/10"
											style={vtName}
										/>
									)}
									{active && (
										<span
											aria-hidden="true"
											class="absolute inset-y-1.5 -left-[9px] w-0.5 rounded-full bg-primary"
										/>
									)}
									<span
										class={cn(
											'relative inline-flex w-10 shrink-0 items-center font-mono text-[10px] font-semibold uppercase',
											endpoint.isWebhook
												? 'text-fuchsia-600 dark:text-fuchsia-300'
												: methodClassMap[endpoint.method]
										)}
									>
										{endpoint.isWebhook ? (
											<Webhook size={12} />
										) : endpoint.method === 'delete' ? (
											'del'
										) : (
											endpoint.method
										)}
									</span>
									<span
										class={cn(
											'relative min-w-0 flex-1 truncate',
											endpoint.deprecated && 'line-through opacity-60'
										)}
									>
										{endpoint.label}
									</span>
								</a>
							);
						})}
					</SidebarGroup>
				))}
				{spec.model.schemas.length > 0 && (
					<SidebarGroup
						title={t('schemas', locale)}
						dataGroupId={`api-${spec.specId}-schemas`}
						isActive={spec.model.schemas.some((schema) =>
							isActiveHref(schemaHref(spec, schema.name))
						)}
					>
						{spec.model.schemas.map((schema) => {
							const href = schemaHref(spec, schema.name);
							const active = isActiveHref(href);
							return (
								<a
									href={href}
									class={linkClass(active)}
									aria-current={active ? 'page' : undefined}
								>
									{active && (
										<span
											aria-hidden="true"
											class="absolute inset-0 rounded-md bg-primary/10"
											style={vtName}
										/>
									)}
									{active && (
										<span
											aria-hidden="true"
											class="absolute inset-y-1.5 -left-[9px] w-0.5 rounded-full bg-primary"
										/>
									)}
									<span class="relative truncate font-mono text-[13px]">
										{schema.name}
									</span>
								</a>
							);
						})}
					</SidebarGroup>
				)}
			</Fragment>
		) : (
			<SidebarNavItems items={nav} locale={locale} animate={animate} />
		)}
	</div>
</nav>

<script>
	const read = (id: string) => {
		try {
			return localStorage.getItem(`sidebar-group-${id}`);
		} catch {
			return null;
		}
	};
	const write = (id: string, value: string) => {
		try {
			localStorage.setItem(`sidebar-group-${id}`, value);
		} catch {
			// storage blocked, state just won't persist
		}
	};

	function setupSidebar() {
		for (const details of document.querySelectorAll<HTMLDetailsElement>(
			'.sidebar-group-details'
		)) {
			const id = details.dataset.groupId ?? '';
			if (details.dataset.active === 'true') details.open = true;
			else if (read(id) === 'open') details.open = true;
			else if (read(id) === 'closed') details.open = false;
			if (details.dataset.bound) continue;
			details.dataset.bound = 'true';
			details.addEventListener('toggle', () => write(id, details.open ? 'open' : 'closed'));
		}

		// Bring the current page into view without jumping when it's already visible.
		for (const scroller of document.querySelectorAll<HTMLElement>('[data-sidebar-scroll]')) {
			const current = scroller.querySelector('[aria-current="page"]');
			if (!current || !scroller.offsetParent) continue;
			const box = scroller.getBoundingClientRect();
			const item = current.getBoundingClientRect();
			if (item.top < box.top + 24 || item.bottom > box.bottom - 24) {
				scroller.scrollTop += item.top - box.top - box.height / 3;
			}
		}
	}

	document.addEventListener('astro:page-load', setupSidebar);
</script>
