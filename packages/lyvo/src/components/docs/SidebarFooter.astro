---
import { ArrowUpRight } from '@lucide/astro';
import Icon from '@lyvo/components/base/Icon.astro';
import ThemeSwitch from '@lyvo/components/base/ThemeSwitch.astro';
import LanguagePicker from '@lyvo/components/docs/LanguagePicker.astro';
import { currentLocale } from '@lyvo/lib/docs';
import { isExternal } from '@lyvo/lib/utils';
import { stripBase } from '@lyvo/lib/url';
import config from 'virtual:lyvo-config';

interface Props {
	/** API sections are language-neutral, so the picker is hidden there. */
	showLanguage?: boolean;
}

const { showLanguage = true } = Astro.props;
const locale = currentLocale(Astro.url.pathname);

// Docs and API are reachable through the section picker already.
const links = config.nav.filter(
	(link) =>
		![config.docs.prefix, config.api.root, '/'].includes(
			stripBase(link.href).replace(/\/+$/, '') || '/'
		)
);
---

<div class="shrink-0 space-y-3 border-t border-border/60 p-3">
	{links.length > 0 && (
		<div class="flex flex-col">
			{links.map((link) => {
				const external = isExternal(link.href);
				return (
					<a
						href={link.href}
						target={external ? '_blank' : undefined}
						rel={external ? 'noopener noreferrer' : undefined}
						class="group/link flex items-center justify-between rounded-md px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent/60 hover:text-foreground"
					>
						{link.title}
						{external && (
							<ArrowUpRight
								size={14}
								class="opacity-50 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 group-hover/link:opacity-100"
							/>
						)}
					</a>
				);
			})}
		</div>
	)}

	{showLanguage && <LanguagePicker />}

	<div class="flex items-center gap-1">
		{config.socials.map((social) => (
			<a
				href={social.href}
				target="_blank"
				rel="noopener noreferrer"
				title={social.label}
				class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground [&>svg]:size-4 [&>svg]:dark:invert"
			>
				<Icon name={social.icon} size={16} />
				<span class="sr-only">{social.label}</span>
			</a>
		))}
		<div class="ml-auto">
			<ThemeSwitch locale={locale} />
		</div>
	</div>
</div>
