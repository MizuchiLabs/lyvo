---
import { ExternalLink, Languages } from '@lucide/astro';
import Icon from '@lyvo/components/base/Icon.astro';
import { isExternal } from '@lyvo/lib/utils';
import { t } from '@lyvo/lib/i18n';
import { currentLocale } from '@lyvo/lib/docs';
import config from 'virtual:lyvo-config';

const locale = currentLocale(Astro.url.pathname);
const currentPath = Astro.url.pathname;
const activeLocale = locale ?? config.i18n.defaultLocale;

const switcherLocales = [
	{
		code: config.i18n.defaultLocale,
		label: config.i18n.labels[config.i18n.defaultLocale] ?? config.i18n.defaultLocale
	},
	...config.i18n.locales.map((locale) => ({
		code: locale.code,
		label: config.i18n.labels[locale.code] ?? locale.label
	}))
];

// Page id of the current docs page without locale or prefix, e.g. "guides/x".
const rest = locale ? currentPath.slice(locale.length + 1) : currentPath;
const prefix = config.docs.prefix;
const currentPageId = rest.startsWith(`${prefix}/`)
	? rest.slice(prefix.length + 1).replace(/\/+$/, '') || null
	: null;

// Fallback routes exist for untranslated pages under every locale, so the
// switcher can always keep the current page path instead of dropping to the
// locale index.
function localeHref(code: string): string {
	const base = `/${code}${prefix}`;
	return currentPageId ? `${base}/${currentPageId}` : base;
}

const localeHrefs = new Map<string, string>();
for (const locale of switcherLocales) {
	localeHrefs.set(locale.code, localeHref(locale.code));
}

const extraLinks = config.extraLinks;
const socials = config.socials;
const hasContent =
	switcherLocales.length > 1 ||
	(extraLinks && extraLinks.length > 0) ||
	(socials && socials.length > 0);
---

{
	hasContent && (
		<div class="mt-auto p-4">
			{switcherLocales.length > 1 && (
				<div class="mb-4 flex flex-col gap-1">
					<p class="flex items-center gap-1.5 px-2 pb-1 text-[11px] font-semibold tracking-wider text-muted-foreground/70 uppercase">
						<Languages size={12} />
						{t('language', locale)}
					</p>
					<div class="flex flex-wrap gap-1 px-1">
						{switcherLocales.map((locale) => (
							<a
								href={localeHrefs.get(locale.code)}
								aria-current={activeLocale === locale.code ? 'page' : undefined}
								class:list={[
									'rounded-md px-2 py-1 text-xs font-medium transition-colors',
									activeLocale === locale.code
										? 'bg-accent/50 text-foreground'
										: 'text-muted-foreground hover:bg-muted/50 hover:text-foreground'
								]}
							>
								{locale.label}
							</a>
						))}
					</div>
				</div>
			)}

			{extraLinks && extraLinks.length > 0 && (
				<div class="mb-4 flex flex-col gap-1">
					{extraLinks.map((link) => {
						const external = isExternal(link.href);
						return (
							<a
								href={link.href}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
								class="flex items-center justify-between rounded-md p-2 text-xs text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground"
							>
								{link.title}
								{external && <ExternalLink size={12} class="opacity-50" />}
							</a>
						);
					})}
				</div>
			)}

			{((extraLinks && extraLinks.length > 0) || switcherLocales.length > 1) &&
				socials &&
				socials.length > 0 && <div class="h-px w-full bg-border/40" />}

			{socials && socials.length > 0 && (
				<div class="mt-4 flex items-center gap-1">
					{socials.map((social) => (
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
							title={social.label}
						>
							<span class="flex items-center justify-center [&>svg]:size-5 [&>svg]:dark:invert">
								<Icon name={social.icon} />
							</span>
							<span class="sr-only">{social.label}</span>
						</a>
					))}
				</div>
			)}
		</div>
	)
}
