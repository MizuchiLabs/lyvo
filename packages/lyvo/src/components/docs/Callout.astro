---
import {
	Info,
	TriangleAlert,
	CircleX,
	CircleCheck,
	Lightbulb,
	StickyNote,
	CircleQuestionMark
} from '@lucide/astro';

type CalloutType =
	'default' | 'info' | 'warning' | 'danger' | 'error' | 'success' | 'note' | 'tip' | 'question';

interface Props {
	type?: CalloutType;
	title?: string;
}

const { type = 'default', title } = Astro.props;

// Each variant takes its color from one theme token.
const variants = {
	default: { Icon: Info, token: 'info' },
	warning: { Icon: TriangleAlert, token: 'warning' },
	danger: { Icon: CircleX, token: 'destructive' },
	success: { Icon: CircleCheck, token: 'success' },
	tip: { Icon: Lightbulb, token: 'tip' },
	note: { Icon: StickyNote, token: 'muted-foreground' },
	question: { Icon: CircleQuestionMark, token: 'info' }
} as const;

const aliases: Partial<Record<CalloutType, keyof typeof variants>> = {
	info: 'default',
	error: 'danger'
};

const resolvedType = aliases[type] || (type as keyof typeof variants);
const { Icon, token } = variants[resolvedType] || variants.default;
---

<div
	class="callout my-6 flex items-start rounded-xl border p-4 shadow-sm"
	style={`--callout: var(--${token})`}
>
	<Icon class="callout-icon mt-0.5 mr-3 h-5 w-5 shrink-0" />
	<div class="w-full min-w-0">
		{title && <h5 class="mb-1 leading-none font-semibold tracking-tight">{title}</h5>}
		<div class="text-sm leading-relaxed opacity-90 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0">
			<slot />
		</div>
	</div>
</div>

<style>
	.callout {
		border-color: color-mix(in oklab, var(--callout) 30%, transparent);
		background-color: color-mix(in oklab, var(--callout) 10%, transparent);
		color: color-mix(in oklab, var(--callout) 50%, var(--foreground));
	}
	.callout > :global(.callout-icon) {
		color: var(--callout);
	}
</style>
