---
import { Calendar } from '@lucide/astro';
import { t } from '@lyvo/lib/i18n';
import { localeFromPath, type RoutingInfo } from '@lyvo/lib/routing';
import config from 'virtual:lyvo-config';

interface Props {
	title: string;
	description?: string;
	lastUpdated?: string;
}

const { title, description, lastUpdated } = Astro.props;

const routing: RoutingInfo = {
	docsPrefix: config.docs.prefix,
	apiRoot: config.api.root,
	defaultLocale: config.i18n.defaultLocale,
	locales: config.i18n.locales
};

const locale = localeFromPath(Astro.url.pathname, routing);
---

<div class="space-y-2">
	<h1 class="scroll-m-20 text-4xl font-bold tracking-tight">{title}</h1>
	{description && <p class="text-lg text-muted-foreground">{description}</p>}
</div>

{
	lastUpdated && (
		<div class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
			<Calendar size={16} />
			{t('lastUpdated', locale)} {lastUpdated}
		</div>
	)
}
