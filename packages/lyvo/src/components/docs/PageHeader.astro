---
import { Calendar } from '@lucide/astro';
import PageActions from '@lyvo/components/docs/PageActions.astro';
import { getI18n } from '@lyvo/lib/i18n';

interface Props {
	title: string;
	description?: string;
	lastUpdated?: Date | null;
	markdown?: string;
}

const { title, description, lastUpdated, markdown } = Astro.props;
const { lang, t } = getI18n(Astro.url);

const formatted = lastUpdated
	? new Intl.DateTimeFormat(lang, { dateStyle: 'medium' }).format(lastUpdated)
	: null;
// Strings without the placeholder still work, the date then follows the text.
const [beforeDate, afterDate] = t('lastUpdated').split('{date}');
---

<div class="space-y-2">
	<div class="flex flex-wrap items-start justify-between gap-4">
		<h1 class="scroll-m-20 text-4xl font-bold tracking-tight">{title}</h1>
		{markdown && <PageActions markdown={markdown} />}
	</div>
	{description && <p class="text-lg text-muted-foreground">{description}</p>}
</div>

{formatted && lastUpdated && (
	<div class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
		<Calendar size={16} />
		{beforeDate}
		<time datetime={lastUpdated.toISOString()}>{formatted}</time>
		{afterDate}
	</div>
)}
