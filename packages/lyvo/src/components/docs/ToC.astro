---
import { TextAlignStart } from '@lucide/astro';
import { t } from '@lyvo/lib/i18n';
import { currentLocale } from '@lyvo/lib/docs';

interface Props {
	headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

const locale = currentLocale(Astro.url.pathname);
---

{
	headings.length > 0 && (
		<div class="toc-desktop sticky top-20 z-10 hidden max-h-[calc(100vh-8rem)] w-64 shrink-0 overflow-y-auto text-muted-foreground select-none xl:block">
			<p class="mb-2 flex items-center gap-2 text-foreground">
				<TextAlignStart size={16} />
				{t('onThisPage', locale)}
			</p>
			<div class="relative flex px-2">
				<div class="toc-mask pointer-events-none absolute top-0 left-1 h-full w-10">
					<div class="absolute inset-0 h-full w-full bg-border" />
					<div class="toc-indicator absolute left-0 w-full bg-foreground transition-all duration-300 ease-out" />
				</div>

				<ul class="toc-links relative flex w-full flex-col pl-3 text-sm">
					{headings.map((heading) => {
						const offset = heading.depth >= 3 ? 12 : 0;
						return (
							<li
								style={`padding-left: ${offset}px`}
								class="transition-colors duration-150 ease-out"
							>
								<a
									href={`#${heading.slug}`}
									data-id={heading.slug}
									data-toc-link
									class="toc-link block py-1.5 pr-2 text-muted-foreground no-underline transition-colors hover:text-foreground"
								>
									{heading.text}
								</a>
							</li>
						);
					})}
				</ul>
			</div>
		</div>
	)
}

<script>
	import '@lyvo/lib/toc';

	interface TocRow {
		x: number;
		top: number;
		bottom: number;
	}

	// Vertical through each row, with a small S-bend bridging depth changes
	// at the row boundary (fumadocs style), not a step or a full-row diagonal.
	function buildTocPath(rows: TocRow[], transition: number) {
		if (rows.length === 0) return '';

		const topSpans = rows.map(() => 0);
		const bottomSpans = rows.map(() => 0);
		for (let i = 1; i < rows.length; i++) {
			if (rows[i].x === rows[i - 1].x) continue;
			const span = Math.max(
				1,
				Math.min(
					transition,
					(rows[i - 1].bottom - rows[i - 1].top) / 2 - 1,
					(rows[i].bottom - rows[i].top) / 2 - 1
				)
			);
			bottomSpans[i - 1] = span;
			topSpans[i] = span;
		}

		let d = `M ${rows[0].x} ${rows[0].top + topSpans[0]}`;
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i];
			d += ` L ${row.x} ${row.bottom - bottomSpans[i]}`;
			const next = rows[i + 1];
			if (next && next.x !== row.x) {
				const y1 = row.bottom - bottomSpans[i];
				const y2 = next.top + topSpans[i + 1];
				const ym = (y1 + y2) / 2;
				// Control points at the mid-height keep tangents vertical on
				// both ends, so the bend blends into the straight segments.
				d += ` C ${row.x} ${ym} ${next.x} ${ym} ${next.x} ${y2}`;
			}
		}
		return d;
	}

	function updateLayout() {
		const linksWrapper = document.querySelector(
			'.toc-desktop .toc-links'
		) as HTMLElement | null;
		const maskElement = document.querySelector('.toc-desktop .toc-mask') as HTMLElement | null;
		if (!linksWrapper || !maskElement) return;

		const links = linksWrapper.querySelectorAll('.toc-link');
		const rows: TocRow[] = [];
		let maxW = 0;
		const strokeWidth = 1.5;
		const halfStroke = strokeWidth / 2;

		links.forEach((link) => {
			const li = link.parentElement;
			if (!li) return;
			const paddingLeft = parseFloat(li.style.paddingLeft) || 0;
			const x = paddingLeft + halfStroke;

			const linkEl = link as HTMLElement;
			const top = linkEl.offsetTop + halfStroke;
			const bottom = linkEl.offsetTop + linkEl.offsetHeight - halfStroke;

			rows.push({ x, top, bottom });
			maxW = Math.max(maxW, x + halfStroke);
		});

		const svgPath = buildTocPath(rows, 10);
		const svgWidth = Math.max(40, maxW + 10);
		const lineHeight = linksWrapper.scrollHeight;

		const svgData = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${svgWidth} ${lineHeight}' width='${svgWidth}' height='${lineHeight}' preserveAspectRatio='none'><path d='${svgPath}' stroke='black' stroke-width='${strokeWidth}' fill='none'/></svg>`;
		const encodedSvg = `url("data:image/svg+xml,${encodeURIComponent(svgData)}")`;

		maskElement.style.maskImage = encodedSvg;
		const style = maskElement.style as CSSStyleDeclaration & { webkitMaskImage: string };
		style.webkitMaskImage = encodedSvg;
		maskElement.style.maskRepeat = 'no-repeat';
		maskElement.style.maskPosition = 'left top';
		maskElement.style.maskSize = '100% 100%';
	}

	function initTocLayout() {
		updateLayout();
	}

	const win = window as Window & { __lyvoTocLayoutSetup?: boolean };
	if (!win.__lyvoTocLayoutSetup) {
		win.__lyvoTocLayoutSetup = true;
		window.addEventListener('resize', updateLayout);
		document.addEventListener('astro:page-load', initTocLayout);
	}
</script>
