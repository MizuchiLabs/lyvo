---
import { ChevronRight } from '@lucide/astro';
import Icon from '@lyvo/components/base/Icon.astro';
import { cn } from '@lyvo/lib/utils';

interface Props {
	title: string;
	icon?: string;
	dataGroupId: string;
	isActive: boolean;
}

const { title, icon, dataGroupId, isActive } = Astro.props;
---

<details
	class="group/folder sidebar-group-details"
	open={isActive}
	data-group-id={dataGroupId}
	data-active={isActive ? 'true' : 'false'}
>
	<summary
		class={cn(
			'flex cursor-pointer list-none items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors select-none hover:bg-accent/60 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none [&::-webkit-details-marker]:hidden',
			isActive ? 'font-medium text-foreground' : 'text-muted-foreground hover:text-foreground'
		)}
	>
		{icon && <Icon name={icon} size={16} class="size-4 shrink-0 opacity-80" />}
		<span class="min-w-0 flex-1 truncate">{title}</span>
		<ChevronRight
			size={14}
			class="shrink-0 opacity-50 transition-transform duration-200 group-open/folder:rotate-90"
		/>
	</summary>
	<div class="relative mt-0.5 ml-3.5 flex flex-col gap-0.5 border-l border-border pl-2">
		<slot />
	</div>
</details>
