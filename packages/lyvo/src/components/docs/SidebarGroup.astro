---
import { cn } from '@lyvo/lib/utils';
import { ChevronRight } from '@lucide/astro';

interface Props {
	title: string;
	dataGroupId: string;
	isActive: boolean;
}

const { title, dataGroupId, isActive } = Astro.props;
---

<details
	class="group sidebar-group-details"
	open={isActive}
	data-group-id={dataGroupId}
	data-active={isActive ? 'true' : 'false'}
>
	<summary
		class={cn(
			'flex cursor-pointer list-none items-center justify-between rounded-md px-2 py-1.5 text-sm font-semibold transition-colors select-none [&::-webkit-details-marker]:hidden',
			isActive
				? 'text-foreground'
				: 'text-muted-foreground hover:bg-muted/50 hover:text-foreground'
		)}
	>
		{title}
		<ChevronRight size={16} class="opacity-50 transition-transform group-open:rotate-90" />
	</summary>
	<div class="mt-1 ml-4 flex flex-col gap-1 border-l border-border/70 pl-2 text-sm">
		<slot />
	</div>
</details>
