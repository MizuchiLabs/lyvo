---
import { ChevronRight } from '@lucide/astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	title: string;
}

const { headings, title } = Astro.props;
const radius = 9;
const circumference = 2 * Math.PI * radius;
---

<div class="mobile-toc-root flex min-w-0 flex-1 items-center xl:hidden" data-title={title}>
	<button
		id="mobile-toc-trigger"
		aria-expanded="false"
		aria-controls="mobile-toc-menu"
		class="flex w-full cursor-pointer items-center space-x-2 text-sm text-muted-foreground transition-colors hover:text-foreground disabled:cursor-default disabled:text-foreground"
		disabled={headings.length === 0}
	>
		<div class="relative -ml-1 flex h-6 w-6 shrink-0 items-center justify-center">
			<svg
				class="h-full w-full -rotate-90 transform text-muted-foreground/30"
				viewBox="0 0 24 24"
			>
				<circle
					cx="12"
					cy="12"
					r={radius}
					stroke="currentColor"
					stroke-width="2"
					fill="none"></circle>
			</svg>
			<svg
				class="absolute h-full w-full -rotate-90 transform text-foreground transition-all duration-150 ease-out"
				viewBox="0 0 24 24"
			>
				<circle
					data-toc-progress
					data-circumference={circumference}
					cx="12"
					cy="12"
					r={radius}
					stroke="currentColor"
					stroke-width="2"
					fill="none"
					stroke-dasharray={circumference}
					stroke-dashoffset={circumference}
					stroke-linecap="round"></circle>
			</svg>
		</div>
		<div class="flex flex-1 items-center gap-1 overflow-hidden font-medium">
			<span data-toc-active-text class="truncate text-left">{title}</span>
			{
				headings.length > 0 && (
					<ChevronRight
						size={14}
						class="mobile-toc-chevron shrink-0 text-muted-foreground transition-transform"
					/>
				)
			}
		</div>
	</button>

	<div
		id="mobile-toc-menu"
		class="absolute top-14 right-0 left-0 z-50 hidden w-full rounded-b-xl border-x border-b border-border/40 bg-background/95 p-4 shadow-xl backdrop-blur-xl"
	>
		<div class="no-scrollbar max-h-[60vh] overflow-y-auto">
			<div class="flex flex-col space-y-1">
				{
					headings.length > 0 ? (
						headings.map((heading) => (
							<a
								href={`#${heading.slug}`}
								data-slug={heading.slug}
								data-toc-link
								data-id={heading.slug}
								class:list={[
									'mobile-toc-link block truncate py-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground',
									{ 'pl-4': heading.depth >= 3 }
								]}
							>
								{heading.text}
							</a>
						))
					) : (
						<span class="text-sm text-muted-foreground">No headings found.</span>
					)
				}
			</div>
		</div>
	</div>
</div>

<script>
	import '@lyvo/lib/toc';

	// Single global listener; points at the current page's menu.
	let activeRoot: Element | null = null;
	let activeToggle: ((force: boolean) => void) | null = null;
	let globalListenerBound = false;

	function initMobileTocMenu() {
		const root = document.querySelector('.mobile-toc-root');
		if (!root) return;

		const triggerEl = document.getElementById('mobile-toc-trigger');
		const menuEl = document.getElementById('mobile-toc-menu');
		const chevron = root.querySelector('.mobile-toc-chevron');
		if (!triggerEl || !menuEl) return;
		const trigger: HTMLElement = triggerEl;
		const menu: HTMLElement = menuEl;

		let isOpen = false;

		function toggleMenu(force?: boolean) {
			isOpen = force !== undefined ? force : !isOpen;
			trigger.setAttribute('aria-expanded', String(isOpen));
			menu.classList.toggle('hidden', !isOpen);
			if (chevron) chevron.classList.toggle('rotate-90', isOpen);
		}

		if (!trigger.dataset.menuBound) {
			trigger.dataset.menuBound = 'true';
			trigger.addEventListener('click', () => toggleMenu());
		}

		activeRoot = root;
		activeToggle = toggleMenu;

		if (!globalListenerBound) {
			globalListenerBound = true;
			document.addEventListener('mousedown', (e) => {
				if (activeToggle && activeRoot && !activeRoot.contains(e.target as Node)) {
					activeToggle(false);
				}
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') activeToggle?.(false);
			});
		}

		menu.querySelectorAll<HTMLAnchorElement>('.mobile-toc-link').forEach((link) => {
			link.addEventListener('click', (e) => {
				const id = link.getAttribute('data-slug');
				const el = id ? document.getElementById(id) : null;
				if (el) {
					e.preventDefault();
					el.scrollIntoView({ behavior: 'smooth' });
					window.history.pushState(null, '', `#${id}`);
					toggleMenu(false);
				}
			});
		});
	}

	document.addEventListener('astro:page-load', initMobileTocMenu);
</script>
