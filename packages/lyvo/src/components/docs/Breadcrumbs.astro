---
import { ChevronRight, Slash } from '@lucide/astro';
import type { Crumb } from '@lyvo/lib/docs';
import { withBase } from '@lyvo/lib/url';

interface Props {
	title?: string;
	trail?: Crumb[];
}

const { title, trail = [] } = Astro.props;
---

<nav
	aria-label="Breadcrumb"
	class="hidden items-center gap-2 text-sm text-muted-foreground xl:flex"
>
	<a href={withBase('/')} class="transition-colors hover:text-foreground" aria-label="Home">
		<Slash size={14} class="mr-2" />
	</a>
	{trail.map((crumb) => (
		<>
			<a href={crumb.href} class="text-foreground/70 transition-colors hover:text-foreground">
				{crumb.title}
			</a>
			<ChevronRight size={14} class="shrink-0 opacity-50" />
		</>
	))}
	<span class="truncate font-medium text-foreground" aria-current="page">
		{title}
	</span>
</nav>
