---
import { ChevronRight } from '@lucide/astro';
import { getDocsHierarchy, docUrl, type NavItem } from '@lyvo/lib/docs';
import { localeFromPath, stripLocaleFromPath, type RoutingInfo } from '@lyvo/lib/routing';
import config from 'virtual:lyvo-config';

interface Props {
	title?: string;
}

const { title } = Astro.props;

const routing: RoutingInfo = {
	docsPrefix: config.docs.prefix,
	apiRoot: config.api.root,
	defaultLocale: config.i18n.defaultLocale,
	locales: config.i18n.locales
};

const { nav } = await getDocsHierarchy(localeFromPath(Astro.url.pathname, routing));

const pathname = stripLocaleFromPath(Astro.url.pathname, routing);
const parts = pathname.split('/').filter(Boolean);

const crumbSections: Array<{ title: string; items: NavItem[] }> = [];
let cursor: NavItem[] | null = nav;

for (const part of parts) {
	if (!cursor) break;

	if (part === config.docs.prefix.replace(/^\//, '') || part === config.api.root.replace(/^\//, '')) {
		continue;
	}

	const categories = cursor.filter(
		(item): item is Extract<NavItem, { type: 'category' }> => item.type === 'category'
	);
	const category =
		categories.find((item) => item.title.toLowerCase() === decodeURIComponent(part.toLowerCase())) ??
		categories.find(
			(item) => item.items.some((child) => child.type === 'doc' && child.id.includes(part))
		);

	if (category) {
		crumbSections.push({ title: category.title, items: category.items });
		cursor = category.items;
	} else {
		cursor = null;
	}
}

---

<div class="hidden items-center space-x-2 text-sm text-muted-foreground xl:flex">
	<a
		href="/"
		class="overflow-hidden text-ellipsis whitespace-nowrap transition-colors hover:text-foreground"
	>
		<ChevronRight size={14} class="-rotate-90" />
	</a>
	{
		crumbSections.map((section) => {
			const firstDoc = section.items.find((item) => item.type === 'doc');
			const href = firstDoc && firstDoc.type === 'doc' ? docUrl(firstDoc.id) : '/';

			return (
				<>
					<span class="text-foreground/70 transition-colors hover:text-foreground">
						<a href={href}>{section.title}</a>
					</span>
					<ChevronRight size={14} class="shrink-0 opacity-50" />
				</>
			);
		})
	}
	<span class="truncate font-medium text-foreground">{title}</span>
</div>
