---
import { ChevronRight, Slash } from '@lucide/astro';
import { getDocsHierarchy, docUrl, getRouting, currentLocale, type NavItem } from '@lyvo/lib/docs';
import { stripLocaleFromPath } from '@lyvo/lib/routing';
import config from 'virtual:lyvo-config';

interface Props {
	title?: string;
}

const { title } = Astro.props;

const routing = getRouting();
const locale = currentLocale(Astro.url.pathname);
const { nav } = await getDocsHierarchy(locale);

const pathname = stripLocaleFromPath(Astro.url.pathname, routing);
const parts = pathname.split('/').filter(Boolean);

const crumbSections: Array<{ title: string; items: NavItem[] }> = [];
let cursor: NavItem[] | null = nav;

for (const part of parts) {
	if (!cursor) break;

	if (
		part === config.docs.prefix.replace(/^\//, '') ||
		part === config.api.root.replace(/^\//, '')
	) {
		continue;
	}

	type CategoryItem = Extract<NavItem, { type: 'category' }>;

	const categories: CategoryItem[] = cursor.filter(
		(item): item is CategoryItem => item.type === 'category'
	);
	const category: CategoryItem | undefined =
		categories.find(
			(item) => item.title.toLowerCase() === decodeURIComponent(part.toLowerCase())
		) ??
		categories.find((item) =>
			item.items.some((child) => child.type === 'doc' && child.id.includes(part))
		);

	if (category) {
		crumbSections.push({ title: category.title, items: category.items });
		cursor = category.items;
	} else {
		cursor = null;
	}
}
---

<div class="hidden items-center gap-2 text-sm text-muted-foreground xl:flex">
	<a
		href="/"
		class="overflow-hidden text-ellipsis whitespace-nowrap transition-colors hover:text-foreground"
	>
		<Slash size={14} class="mr-2" />
	</a>
	{
		crumbSections.map((section) => {
			const firstDoc = section.items.find((item) => item.type === 'doc');
			const href = firstDoc && firstDoc.type === 'doc' ? docUrl(firstDoc.id, locale) : '/';

			return (
				<>
					<span class="text-foreground/70 transition-colors hover:text-foreground">
						<a href={href}>{section.title}</a>
					</span>
					<ChevronRight size={14} class="shrink-0 opacity-50" />
				</>
			);
		})
	}
	<span class="truncate font-medium text-foreground">{title}</span>
</div>
